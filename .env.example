# ---------------------------------------------------------------------------
# VYRALIS environment
# Copy to .env (gitignored) or set these in your hosting dashboard.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Frontend (Vite). Leave empty when using the dev/preview proxy.
VITE_API_BASE_URL=

# Data + API
VYRALIS_DATA_DIR=./data
VYRALIS_CORS_ORIGINS=http://localhost:5173
VYRALIS_WORKERS=1
VYRALIS_MAX_UPLOAD_BYTES=5368709120
VYRALIS_MAX_SOURCE_DURATION=14400
VYRALIS_MAX_SOURCE_HEIGHT=1080
VYRALIS_MAX_SOURCE_BYTES=4294967296

# Transcription
VYRALIS_WHISPER_MODEL=base
VYRALIS_WHISPER_DEVICE=cpu
VYRALIS_WHISPER_COMPUTE=int8

# Deployment URLs (needed for OAuth callbacks and redirects)
# Public origin of this API, e.g. https://vyralis-api.onrender.com
VYRALIS_PUBLIC_URL=
# Origin of the studio frontend, e.g. https://vyralis.vercel.app
VYRALIS_FRONTEND_URL=

# Security
# Encrypts provider tokens at rest. Generate with: openssl rand -hex 32
VYRALIS_AUTH_SECRET=
# Optional HTTP Basic gate for hosted deployments, format user:password
VYRALIS_BASIC_AUTH=

# --- Social platform OAuth clients -----------------------------------------
# See docs/oauth-setup.md for the exact redirect URI to register.
# YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok (Login Kit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram (Meta app with Instagram Graph API)
META_APP_ID=
META_APP_SECRET=
# X (OAuth 2.0 confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=
